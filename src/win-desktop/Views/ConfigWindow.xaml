<ui:FluentWindow x:Class="Hope.Desktop.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:Hope.Desktop.Converters"
        xmlns:controls="clr-namespace:Hope.Desktop.Controls"
        Title="Hope · 盼头" Width="1180" MinWidth="1180" MinHeight="280"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <!-- DatePicker / Calendar 沿用 WPF-UI ControlsDictionary 的 Fluent 隐式样式（深色圆角 + Fluent 日历）。
             日历弹窗背景键 CalendarViewBackground 默认取 ControlFillColorInputActive（暗色下 #B31E1E1E，半透明），
             独立弹窗中会透出桌面；此处仅覆盖该键为不透明表面色，不动其它控件背景。 -->
        <SolidColorBrush x:Key="CalendarViewBackground" Color="{DynamicResource SolidBackgroundFillColorBase}" />
        <!-- 表单字段标签：定宽左列，使所有行的控件竖直对齐（紧凑单行布局） -->
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="56" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- 快填行的次级标签：与字段标签同宽，按钮列对齐 -->
        <Style x:Key="QuickFillLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 全局设置区字段标签：较宽以容纳进度条等设置项标题 -->
        <Style x:Key="SettingsFieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="96" />
        </Style>
        <Style x:Key="SettingsUnitLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 任务编辑区分割线：随 Fluent 主题切换，2px 控制描边色（显眼且与背景对比） -->
        <Style x:Key="TaskEditSeparator" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="2"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                CornerRadius="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 危险操作按钮：自定义模板保证悬停为更深红色（避免主题浅色悬停像禁用） -->
        <Style x:Key="HopeDangerButton" TargetType="{x:Type ui:Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9A1F14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7A1810" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 布尔值与 Visibility 转换器：用于列表中根据完成状态显隐按钮/文本。 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Inverted="True" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Hope · 盼头" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <!-- 任务列表 -->
            <DockPanel Grid.Column="0" x:Name="TaskListPanel" Margin="0,0,12,0">
                <Grid x:Name="TaskListHeaderGrid" DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="任务列表" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="按进行中 / 已完成 / 全部过滤列表" />
                        <ComboBox x:Name="FilterBox" Width="120" VerticalAlignment="Center"
                                  SelectionChanged="OnFilterChanged"
                                  ToolTip="按进行中 / 已完成 / 全部过滤列表">
                            <ComboBoxItem Content="进行中" Tag="active" IsSelected="True" />
                            <ComboBoxItem Content="已完成" Tag="completed" />
                            <ComboBoxItem Content="全部" Tag="all" />
                        </ComboBox>
                        <TextBlock x:Name="NowTimeToolbarText" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="当前时间，便于对照列表起止时间" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" x:Name="AddTaskButton" Content="添加任务"
                               Appearance="Success"
                               Icon="{ui:SymbolIcon Add24}"
                               Padding="12,4" Click="OnAddTask"
                               ToolTip="新建空白任务并进入编辑（ctrl+n）" />
                </Grid>
                <Grid x:Name="TaskListBottomGrid" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                      Visibility="Collapsed">
                    <ui:Button x:Name="DeleteCompletedButton"
                               Content="一键删除所有已完成任务"
                               Style="{StaticResource HopeDangerButton}"
                               HorizontalAlignment="Stretch" Height="32"
                               Click="OnDeleteCompleted"
                               ToolTip="删除列表中所有已完成任务（不可撤销）" />
                </Grid>
                <ui:DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          SelectionChanged="OnSelectTask" GridLinesVisibility="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          CanUserResizeColumns="False"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <DataGrid.Resources>
                        <!-- 选中：行背景高亮；保留主题自带行首指示；单元格文字颜色始终不变。 -->
                        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="0,2" />
                            <!-- 方案 A：关闭 DataGrid 网格线后，由单元格统一画一条底边描边，各列粗细一致。 -->
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <!-- 单元格撑满整行，底边描边才会在各列对齐到统一的行底部；对齐由列内容自行控制。 -->
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <!-- 选中不改文字色，仅由行背景与主题行首指示区分。 -->
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- 文本列前景色固定；对齐用 HorizontalAlignment，不改表头 ControlTemplate。 -->
                        <Style x:Key="TaskGridNameTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                        <Style x:Key="TaskGridCenteredTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                        <!--
                          三列表头居中：WPF-UI 默认 HorizontalContentAlignment=Left，只改 TextBlock 无效。
                          基于 DefaultUiDataGridColumnHeaderStyle，仅把内容槽改为 Stretch，标题用 TextAlignment 居中；
                          不重写 ControlTemplate，保留主题 Padding/Hover/Sort。
                        -->
                        <Style x:Key="TaskGridCenteredHeaderStyle"
                               TargetType="{x:Type DataGridColumnHeader}"
                               BasedOn="{StaticResource DefaultUiDataGridColumnHeaderStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- 除「名称」外列宽 Auto；名称列 *。表头用 TextBlock 只调对齐/边距，不覆盖主题 Header 样式。 -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="颜色" HorizontalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="16" Height="16" CornerRadius="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding ColorBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Width="*"
                                            ElementStyle="{StaticResource TaskGridNameTextStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="名称" HorizontalAlignment="Left" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TypeLabel}" Width="Auto"
                                            ElementStyle="{StaticResource TaskGridCenteredTextStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="类型" HorizontalAlignment="Center" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RecurLabel}" Width="Auto"
                                            ElementStyle="{StaticResource TaskGridCenteredTextStyle}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="循环" HorizontalAlignment="Center" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!-- 起止列：表头用 TaskGridCenteredHeaderStyle 居中；单元格外缘 16、相邻内侧 8。 -->
                        <DataGridTemplateColumn Width="Auto"
                                                HeaderStyle="{StaticResource TaskGridCenteredHeaderStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="开始" HorizontalAlignment="Stretch" TextAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AlternatingDateText Value="{Binding StartDisplayAt}"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="16,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto"
                                                HeaderStyle="{StaticResource TaskGridCenteredHeaderStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="截止" HorizontalAlignment="Stretch" TextAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AlternatingDateText Value="{Binding EndDisplayAt}"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="8,0,16,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 进度列固定 100；表头同样 Stretch + TextAlignment 居中。 -->
                        <DataGridTemplateColumn Width="100" MinWidth="100" MaxWidth="100"
                                                HeaderStyle="{StaticResource TaskGridCenteredHeaderStyle}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="进度" HorizontalAlignment="Stretch" TextAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AlternatingProgressText
                                        HorizontalAlignment="Stretch"
                                        Primary="{Binding ProgressLabel}"
                                        Secondary="{Binding ProgressSpanLabel}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 操作列固定，保证「完成/重建」始终可见。 -->
                        <DataGridTemplateColumn Width="56" MinWidth="56" MaxWidth="56">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="操作" HorizontalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:Button Content="完成" Padding="6,2" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding Id}"
                                                   Click="OnCompleteTask"
                                                   ToolTip="标记该任务为已完成"
                                                   Visibility="{Binding Completed, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                        <ui:Button Content="重建" Padding="6,2" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding Id}"
                                                   Click="OnRecreateTask"
                                                   ToolTip="基于该已完成任务创建新任务"
                                                   Visibility="{Binding Completed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>
            </DockPanel>

            <!-- 右侧：全局设置 / 任务编辑 双 Tab -->
            <TabControl Grid.Column="1" x:Name="MainTabs"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <!-- 全局设置 -->
                <TabItem Header="全局设置" x:Name="SettingsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Top"
                                  CanContentScroll="False" Focusable="False">
                        <StackPanel x:Name="SettingsPanel" Margin="4,8,8,4" VerticalAlignment="Top">
                            <TextBlock Text="全局设置" FontWeight="Bold" Margin="0,0,0,8" />

                            <!-- 进度条设置分组 -->
                            <Grid Margin="0,6,0,8">
                                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="进度条设置" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </Grid>

                            <ui:Button x:Name="RefreshProgressBarButton" Content="刷新进度条(ctrl+r)"
                                         Appearance="Primary"
                                         Background="{DynamicResource AccentFillColorDefaultBrush}"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                         HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,0"
                                         Click="OnRefreshProgressBarClick"
                                         ToolTip="重建进度条窗口（不改变任务进度）" />

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="粗细"
                                           ToolTip="进度条粗细（像素）" />
                                <TextBlock Style="{StaticResource SettingsUnitLabel}" DockPanel.Dock="Right" Text="px" />
                                <TextBlock x:Name="BarHeightValueText" DockPanel.Dock="Right"
                                           Width="20" TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Slider x:Name="BarHeightBox" Minimum="1" Maximum="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="图片最大高度"
                                           ToolTip="默认图片最大高度；开启「允许为单个任务设置图片高度」后可被单个任务覆盖" />
                                <TextBlock Style="{StaticResource SettingsUnitLabel}" DockPanel.Dock="Right" Text="px" />
                                <TextBlock x:Name="ImageMaxHeightValueText" DockPanel.Dock="Right"
                                           Width="20" TextAlignment="Right" VerticalAlignment="Center"
                                           Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Slider x:Name="ImageMaxHeightBox" Minimum="15" Maximum="30" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="起始位置"
                                           ToolTip="进度条在屏幕上的位置" />
                                <ComboBox x:Name="BarPositionBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnBarPositionChanged">
                                    <ComboBoxItem Content="屏幕顶边" Tag="top" IsSelected="True" />
                                    <ComboBoxItem Content="屏幕底边" Tag="bottom" />
                                    <ComboBoxItem Content="屏幕左边" Tag="left" />
                                    <ComboBoxItem Content="屏幕右边" Tag="right" />
                                </ComboBox>
                            </DockPanel>

                            <DockPanel x:Name="SingleDirectionPanel" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="起始前进方向"
                                           ToolTip="进度条填充前进方向" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="BarForwardRadio" GroupName="BarDirection" Content="→"
                                                 Tag="forward" IsChecked="True" Margin="0,0,16,0"
                                                 HorizontalAlignment="Left"
                                                 ToolTip="从左到右 / 从上到下" />
                                    <RadioButton x:Name="BarReverseRadio" GroupName="BarDirection" Content="←"
                                                 Tag="reverse" HorizontalAlignment="Left"
                                                 ToolTip="从右到左 / 从下到上" />
                                </StackPanel>
                            </DockPanel>

                            <StackPanel x:Name="BarAdvancedOptionsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="刷新频率"
                                               ToolTip="进度条更新频率（秒/次）" />
                                    <TextBlock Style="{StaticResource SettingsUnitLabel}" DockPanel.Dock="Right" Text="秒/次" />
                                    <TextBlock x:Name="RefreshValueText" DockPanel.Dock="Right"
                                               Width="20" TextAlignment="Right" VerticalAlignment="Center"
                                               Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Slider x:Name="RefreshBox" Minimum="1" Maximum="10" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                </DockPanel>

                                <CheckBox x:Name="AllFourCheck" Content="我全都要（四边环绕）"
                                          Margin="0,12,0,0" HorizontalAlignment="Left"
                                          Checked="OnAllFourChanged" Unchecked="OnAllFourChanged"
                                          ToolTip="从起始位置出发，沿前进方向环绕屏幕四边" />

                                <CheckBox x:Name="AdvancedPositionCheck" Content="允许为单个任务指定展示位置"
                                          Margin="0,12,0,0" HorizontalAlignment="Left"
                                          ToolTip="开启后，任务编辑中可为每个任务指定屏幕边缘；各边前进方向由下方设置决定" />

                                <CheckBox x:Name="AdvancedImageHeightCheck" Content="允许为单个任务设置图片高度"
                                          Margin="0,12,0,0" HorizontalAlignment="Left"
                                          ToolTip="开启后，任务编辑中可取消「使用全局图片高度」，为单个任务单独设定图片最大高度" />

                                <StackPanel x:Name="PerEdgeDirectionPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,8">
                                        <Border Height="1" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock Text="屏幕各边缘进度条前进方向设置" HorizontalAlignment="Center"
                                                   Background="{DynamicResource ApplicationBackgroundBrush}"
                                                   Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,8">
                                            <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" Text="屏幕顶边" />
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" x:Name="TopForwardRadio" GroupName="TopDirection" Content="→"
                                                             Tag="forward" IsChecked="True" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从左到右" />
                                                <RadioButton Grid.Column="2" x:Name="TopReverseRadio" GroupName="TopDirection" Content="←"
                                                             Tag="reverse" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从右到左" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" Text="屏幕底边" />
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" x:Name="BottomForwardRadio" GroupName="BottomDirection" Content="→"
                                                             Tag="forward" IsChecked="True" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从左到右" />
                                                <RadioButton Grid.Column="2" x:Name="BottomReverseRadio" GroupName="BottomDirection" Content="←"
                                                             Tag="reverse" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从右到左" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" Text="屏幕左边" />
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" x:Name="LeftForwardRadio" GroupName="LeftDirection" Content="↓"
                                                             Tag="forward" IsChecked="True" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从上到下" />
                                                <RadioButton Grid.Column="2" x:Name="LeftReverseRadio" GroupName="LeftDirection" Content="↑"
                                                             Tag="reverse" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从下到上" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,8,0" Text="屏幕右边" />
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" x:Name="RightForwardRadio" GroupName="RightDirection" Content="↓"
                                                             Tag="forward" IsChecked="True" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从上到下" />
                                                <RadioButton Grid.Column="2" x:Name="RightReverseRadio" GroupName="RightDirection" Content="↑"
                                                             Tag="reverse" VerticalAlignment="Center"
                                                             MinWidth="0" ToolTip="从下到上" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <ui:Button x:Name="ToggleAdvancedOptionsButton" Content="显示高级选项"
                                         HorizontalAlignment="Stretch" Height="32" Margin="0,12,0,0"
                                         Click="OnToggleAdvancedOptionsClick"
                                         ToolTip="展开或收起进度条高级选项" />

                            <Grid Margin="0,6,0,8">
                                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="任务提醒设置" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </Grid>

                            <CheckBox x:Name="GlobalNotifyCheck" Content="系统通知"
                                      Margin="0,12,0,0" HorizontalAlignment="Left"
                                      ToolTip="到期时弹出一次系统气球通知" />

                            <TextBlock Text="到期提醒效果" Margin="0,12,0,2"
                                       TextWrapping="Wrap" HorizontalAlignment="Left"
                                       ToolTip="到期后进度条的额外动效（可与系统通知叠加）" />
                            <RadioButton x:Name="GlobalReminderNoneRadio" GroupName="GlobalReminder" Content="无"
                                         Margin="11,2,0,0" HorizontalAlignment="Left"
                                         ToolTip="到期后仅保持满色显示，无额外动效" />
                            <RadioButton x:Name="GlobalBlinkRadio" GroupName="GlobalReminder" Content="呼吸提醒"
                                         Margin="11,2,0,0" HorizontalAlignment="Left"
                                         ToolTip="到期后顶栏柔和呼吸，直到用户查看" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                                <RadioButton x:Name="GlobalCelebrateRadio" GroupName="GlobalReminder" Content="全屏庆祝"
                                             Margin="11,0,0,0" VerticalAlignment="Center"
                                             ToolTip="到期时四边同步呼吸庆祝" />
                                <TextBlock VerticalAlignment="Center"
                                           Visibility="{Binding IsChecked, ElementName=GlobalCelebrateRadio, Converter={StaticResource BoolToVisibilityConverter}}"><Run Text="⚠️" /><Run Text="光敏性癫痫警告" Foreground="Red" /><Run Text="⚠️" /></TextBlock>
                            </StackPanel>

                            <Grid Margin="0,6,0,8">
                                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="应用启动设置" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </Grid>

                            <CheckBox x:Name="AutostartCheck" Content="开机自启动" Margin="0,16,0,0"
                                      HorizontalAlignment="Left"
                                      ToolTip="登录 Windows 后自动启动 Hope" />

                            <CheckBox x:Name="ShowConfigAtRuntimeCheck" Content="运行时显示此窗口"
                                      Margin="0,12,0,0" HorizontalAlignment="Left"
                                      ToolTip="开启后，下次启动 Hope 时自动打开本配置窗口（默认仅托盘驻留）" />

                            <CheckBox x:Name="AutoUpdateCheck" Content="自动下载更新" Margin="0,12,0,0"
                                      HorizontalAlignment="Left"
                                      ToolTip="开启后发现新版本将自动下载，下载完成后提示安装；关闭后仅检测并提示，不自动下载" />

                            <CheckBox x:Name="AllowTelemetryCheck" Content="允许发送软件活跃信息" Margin="0,12,0,0"
                                      HorizontalAlignment="Left"
                                      ToolTip="开启后会匿名上报启动/每日活跃与更新结果，仅用于了解装机量、活跃与更新成功率，不含任何可识别个人信息；取消勾选后不发送任何信息" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 任务编辑 -->
                <TabItem Header="任务编辑" x:Name="TaskTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Top"
                                  CanContentScroll="False" Focusable="False">
                        <StackPanel x:Name="TaskEditPanel" Margin="4,8,8,4" VerticalAlignment="Top">
                            <TextBlock x:Name="StatusText" Text="新建任务" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,6" TextWrapping="Wrap"
                                       ToolTip="当前为新建或正在编辑哪条任务（操作结果见右下 Toast）" />

                            <!-- 名称：输入占满一行；快填缩小放下方；最多 16 汉字宽（32 半角）。 -->
                            <StackPanel Margin="0,3,0,0">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="名称"
                                               ToolTip="任务显示名称，最多 16 个汉字（或 32 个半角字符）" />
                                    <ui:TextBox x:Name="NameBox" PlaceholderText="任务名称"
                                                HorizontalAlignment="Stretch"
                                                TextChanged="OnNameBoxTextChanged"
                                                ToolTip="任务显示名称，最多 16 个汉字（或 32 个半角字符）" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="64,4,0,0">
                                    <ui:Button Content="下班" Padding="6,1" Margin="0,0,6,0" FontSize="11"
                                               Click="OnPresetName" ToolTip="将名称设为「下班」" />
                                    <ui:Button Content="干饭" Padding="6,1" Margin="0,0,6,0" FontSize="11"
                                               Click="OnPresetName" ToolTip="将名称设为「干饭」" />
                                    <ui:Button Content="放假" Padding="6,1" FontSize="11"
                                               Click="OnPresetName" ToolTip="将名称设为「放假」" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 颜色 -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="颜色"
                                           ToolTip="进度条上该任务的颜色（#RRGGBB）" />
                                <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="28" Height="28"
                                        CornerRadius="4" Margin="6,0,0,0" Background="#FF6B35"
                                        Cursor="Hand" MouseLeftButtonUp="OnPickColor"
                                        ToolTip="点击打开系统取色盘选择颜色" />
                                <ui:TextBox x:Name="ColorBox" Text="#FF6B35" TextChanged="OnColorChanged"
                                            ToolTip="颜色代码 #RRGGBB" />
                            </DockPanel>

                            <!-- 展示位置（仅在高级设置中开启后显示） -->
                            <DockPanel x:Name="TaskPositionRow" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="展示位置"
                                           ToolTip="空表示沿用全局位置；方向由全局各边设置决定" />
                                <ComboBox x:Name="TaskPositionBox" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="沿用全局&#x9;" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="屏幕顶边&#x9;" Tag="top" />
                                    <ComboBoxItem Content="屏幕底边&#x9;" Tag="bottom" />
                                    <ComboBoxItem Content="屏幕左边&#x9;" Tag="left" />
                                    <ComboBoxItem Content="屏幕右边&#x9;" Tag="right" />
                                </ComboBox>
                            </DockPanel>

                            <!-- 开启「允许为单个任务设置图片高度」时，图片相关控件归为同一分区 -->
                            <Grid x:Name="TaskImageSectionSeparator" Margin="0,14,0,10" Visibility="Collapsed">
                                <Border Height="2" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        CornerRadius="1" />
                                <TextBlock Text="当前任务图片设置" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </Grid>
                            <!-- 图片 / 动图：预览框，展示 30px 高度的图片预览（动图可动） -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="图片"
                                           ToolTip="支持常见图片；跟随进度移动；动图可循环；超出最大高度自动缩放" />
                                <ui:Button DockPanel.Dock="Right" Content="清除" Width="52" Margin="6,0,0,0" Click="OnClearGif"
                                           ToolTip="清除本任务图片" />
                                <ui:Button DockPanel.Dock="Right" Content="选择" Width="52" Margin="6,0,0,0" Click="OnBrowseGif"
                                           ToolTip="选择图片或动图文件" />
                                <Border x:Name="GifPreviewBox" Height="40" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        AllowDrop="True" PreviewDragOver="OnGifDragOver" Drop="OnGifDrop"
                                        ToolTip="可拖拽图片到此处">
                                    <Grid Margin="8,0">
                                        <TextBlock x:Name="GifPlaceholder" Text="可拖拽图片或动图到此处"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ContentControl x:Name="GifPreviewHost" IsTabStop="False"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- 任务级图片高度（仅在高级设置中开启后显示） -->
                            <StackPanel x:Name="TaskImageHeightPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                <CheckBox x:Name="TaskUseGlobalImageHeightCheck" Content="使用全局图片高度"
                                          IsChecked="True" HorizontalAlignment="Left"
                                          ToolTip="勾选时沿用全局「图片最大高度」；取消后可为本任务单独设定" />
                                <DockPanel x:Name="TaskImageMaxHeightRow" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="最大高度"
                                               ToolTip="本任务图片的最大高度，超出按比例缩放" />
                                    <TextBlock Style="{StaticResource SettingsUnitLabel}" DockPanel.Dock="Right" Text="px" />
                                    <TextBlock x:Name="TaskImageMaxHeightValueText" DockPanel.Dock="Right"
                                               Width="20" TextAlignment="Right" VerticalAlignment="Center"
                                               Margin="8,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Slider x:Name="TaskImageMaxHeightBox" Minimum="15" Maximum="30" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>

                            <Separator Style="{StaticResource TaskEditSeparator}" />

                            <!-- 类型 -->
                            <DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="类型"
                                           ToolTip="定时含开始时间；倒计时从创建时刻起算，可按时长或按截止编辑（二选一）" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TypeScheduledRadio" GroupName="TaskType"
                                                 Content="定时任务"
                                                 IsChecked="True"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 ToolTip="含开始时间：按设定的开始与截止时间计算进度" />
                                    <RadioButton x:Name="TypeInstantRadio" GroupName="TaskType"
                                                 Content="倒计时"
                                                 Margin="12,0,0,0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 ToolTip="从创建时刻起算：默认按时长（天/时/分）编辑，也可切换为按截止时刻" />
                                </StackPanel>
                            </DockPanel>

                            <!-- 循环（仅定时任务；倒计时的「循环」在下方倒计时面板内）。开始/截止的时分定义每个发生日窗口，开始日期为锚点 -->
                            <StackPanel x:Name="RecurPanel">
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="循环"
                                               ToolTip="循环任务：每个发生日重复开始~截止窗口（支持跨午夜）" />
                                    <ComboBox x:Name="RecurModeBox" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnRecurModeChanged">
                                        <ComboBoxItem Content="不循环（单次）" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="每天" Tag="daily" />
                                        <ComboBoxItem Content="间隔若干天循环" Tag="everyN" />
                                        <ComboBoxItem Content="按星期" Tag="weekly" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="RecurIntervalRow" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource QuickFillLabel}" Text="间隔"
                                               ToolTip="每隔多少天重复一次（2–800）" />
                                    <ui:TextBox x:Name="RecurIntervalBox" DockPanel.Dock="Left" Width="80"
                                                MaxLength="3" PlaceholderText="2" TextChanged="OnRecurIntervalChanged"
                                                ToolTip="每隔多少天重复一次（2–800）" />
                                    <TextBlock Text="天循环（2~800）" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <DockPanel x:Name="RecurWeekRow" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource QuickFillLabel}" Text="星期" VerticalAlignment="Top"
                                               ToolTip="选择每周重复的星期" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkMon" Content="一" Tag="1" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周一" />
                                            <CheckBox x:Name="ChkTue" Content="二" Tag="2" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周二" />
                                            <CheckBox x:Name="ChkWed" Content="三" Tag="3" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周三" />
                                            <CheckBox x:Name="ChkThu" Content="四" Tag="4" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周四" />
                                            <CheckBox x:Name="ChkFri" Content="五" Tag="5" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周五" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <CheckBox x:Name="ChkSat" Content="六" Tag="6" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周六" />
                                            <CheckBox x:Name="ChkSun" Content="日" Tag="0" MinWidth="0" Padding="6,0,0,0" Margin="0,0,5,0" ToolTip="周日" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <!-- 到期提醒已统一由全局设置管理；任务级覆盖能力仍保留于数据模型，但表单不再暴露选项。 -->

                            <StackPanel x:Name="StartPanel">
                                <Separator Style="{StaticResource TaskEditSeparator}" />
                                <!-- 开始日期 -->
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="开始日期"
                                               ToolTip="定时任务的开始日期" />
                                    <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch"
                                                ToolTip="选择开始日期" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource QuickFillLabel}" Text="快填"
                                               ToolTip="一键填入常用日期" />
                                    <WrapPanel>
                                        <ui:Button Content="今天" Tag="StartDate:Today" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入今天" />
                                        <ui:Button Content="明天" Tag="StartDate:Tomorrow" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入明天" />
                                        <ui:Button Content="后天" Tag="StartDate:DayAfter" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入后天" />
                                        <ui:Button Content="一周后" Tag="StartDate:Week" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入一周后" />
                                        <ui:Button Content="一月后" Tag="StartDate:Month" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入一月后" />
                                    </WrapPanel>
                                </DockPanel>
                                <!-- 开始时间（时 : 分） -->
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="开始时间"
                                               ToolTip="定时任务开始时刻的时与分" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="StartHourBox" Width="78" IsEditable="True" ToolTip="开始小时 0–23" />
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0,6,0" FontWeight="Bold" />
                                        <ComboBox x:Name="StartMinuteBox" Width="78" IsEditable="True" ToolTip="开始分钟 0–59" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource QuickFillLabel}" Text="快填"
                                               ToolTip="一键填入常用时间" />
                                    <WrapPanel>
                                        <ui:Button Content="现在" Tag="StartTime:Now" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="填入当前时分" />
                                        <ui:Button Content="+0.5H" Tag="StartTime:H0.5" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 0.5 小时" />
                                        <ui:Button Content="+1H" Tag="StartTime:H1" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 1 小时" />
                                        <ui:Button Content="+2H" Tag="StartTime:H2" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 2 小时" />
                                        <ui:Button Content="+8H" Tag="StartTime:H8" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 8 小时" />
                                        <ui:Button Content="+12H" Tag="StartTime:H12" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 12 小时" />
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>

                            <!-- 倒计时：目标 Radio（同「类型」样式）在上，其下为居中只读文案 + 编辑内容。 -->
                            <StackPanel x:Name="CountdownPanel" Visibility="Collapsed">
                                <Separator Style="{StaticResource TaskEditSeparator}" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="80" Text="倒计时目标"
                                               ToolTip="选择倒计时以时长还是以截止时刻为目标来编辑" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CountdownModeDurationRadio" GroupName="CountdownEditMode"
                                                     Content="按时长"
                                                     IsChecked="True"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     Checked="OnCountdownModeRadioChanged"
                                                     ToolTip="按天 / 时 / 分编辑倒计时；截止时刻在下方只读显示" />
                                        <RadioButton x:Name="CountdownModeDeadlineRadio" GroupName="CountdownEditMode"
                                                     Content="按截止"
                                                     Margin="12,0,0,0"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     Checked="OnCountdownModeRadioChanged"
                                                     ToolTip="按截止日期与时刻编辑；倒计时时长在下方只读显示" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="CountdownSummaryHero"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           ToolTip="当前编辑对侧的只读结果：按时长时显示截止时刻，按截止时显示时长" />
                                <StackPanel x:Name="CountdownDurationEdit">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="倒计时"
                                                   ToolTip="从现在起的倒计时时长" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBox x:Name="CountdownDaysBox" Width="86" MaxLength="5"
                                                        PlaceholderText="0" ClearButtonEnabled="False"
                                                        TextChanged="OnCountdownBoxChanged"
                                                        ToolTip="天（0~36500）" />
                                            <TextBlock Text="天" VerticalAlignment="Center" Margin="6,0,10,0" />
                                            <ui:TextBox x:Name="CountdownHoursBox" Width="64" MaxLength="2"
                                                        PlaceholderText="0" ClearButtonEnabled="False"
                                                        TextChanged="OnCountdownBoxChanged"
                                                        ToolTip="小时（0~23）" />
                                            <TextBlock Text="时" VerticalAlignment="Center" Margin="6,0,10,0" />
                                            <ui:TextBox x:Name="CountdownMinutesBox" Width="64" MaxLength="2"
                                                        PlaceholderText="0" ClearButtonEnabled="False"
                                                        TextChanged="OnCountdownBoxChanged"
                                                        ToolTip="分钟（0~59）" />
                                            <TextBlock Text="分" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource QuickFillLabel}" Text="快填"
                                                   ToolTip="一键填入常用倒计时时长" />
                                        <WrapPanel>
                                            <ui:Button Content="30分" Tag="Countdown:M30" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 30 分钟" />
                                            <ui:Button Content="1时" Tag="Countdown:H1" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 1 小时" />
                                            <ui:Button Content="2时" Tag="Countdown:H2" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 2 小时" />
                                            <ui:Button Content="8时" Tag="Countdown:H8" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 8 小时" />
                                            <ui:Button Content="1天" Tag="Countdown:D1" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 1 天" />
                                            <ui:Button Content="7天" Tag="Countdown:D7" Padding="6,2" Margin="2,0,2,2" Click="OnCountdownQuickFill" ToolTip="倒计时 7 天" />
                                        </WrapPanel>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 开始→截止分割线；定时任务在此展示时长 -->
                            <Grid x:Name="DurationDivider" Margin="0,14,0,14">
                                <Border Height="2" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        CornerRadius="1" />
                                <TextBlock x:Name="DurationText" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" Visibility="Collapsed"
                                           ToolTip="开始到截止的时长（起点锚定日历拆分：年/月/天/时/分）" />
                            </Grid>

                            <!-- 截止：定时任务始终可编辑；倒计时仅「按截止」模式可编辑 -->
                            <StackPanel x:Name="EndPanel">
                            <!-- 截止日期 -->
                            <DockPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="截止日期"
                                           ToolTip="任务截止日期" />
                                <DatePicker x:Name="EndDatePicker" HorizontalAlignment="Stretch"
                                            ToolTip="选择截止日期" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource QuickFillLabel}" Text="快填"
                                           ToolTip="一键填入常用日期" />
                                <WrapPanel>
                                    <ui:Button Content="今天" Tag="EndDate:Today" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入今天" />
                                    <ui:Button Content="明天" Tag="EndDate:Tomorrow" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入明天" />
                                    <ui:Button Content="后天" Tag="EndDate:DayAfter" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入后天" />
                                    <ui:Button Content="一周后" Tag="EndDate:Week" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入一周后" />
                                    <ui:Button Content="一月后" Tag="EndDate:Month" Padding="6,2" Margin="2,0,2,2" Click="OnDateQuickFill" ToolTip="填入一月后" />
                                </WrapPanel>
                            </DockPanel>
                            <!-- 截止时间（时 : 分） -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="截止时间"
                                           ToolTip="任务截止时刻的时与分" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="EndHourBox" Width="78" IsEditable="True" ToolTip="截止小时 0–23" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0,6,0" FontWeight="Bold" />
                                    <ComboBox x:Name="EndMinuteBox" Width="78" IsEditable="True" ToolTip="截止分钟 0–59" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource QuickFillLabel}" Text="快填"
                                           ToolTip="一键填入常用时间" />
                                <WrapPanel>
                                    <ui:Button Content="现在" Tag="EndTime:Now" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="填入当前时分" />
                                    <ui:Button Content="+0.5H" Tag="EndTime:H0.5" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 0.5 小时" />
                                    <ui:Button Content="+1H" Tag="EndTime:H1" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 1 小时" />
                                    <ui:Button Content="+2H" Tag="EndTime:H2" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 2 小时" />
                                    <ui:Button Content="+8H" Tag="EndTime:H8" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 8 小时" />
                                    <ui:Button Content="+12H" Tag="EndTime:H12" Padding="6,2" Margin="2,0,2,2" Click="OnTimeQuickFill" ToolTip="当前时间加 12 小时" />
                                </WrapPanel>
                            </DockPanel>
                            </StackPanel>

                            <CheckBox x:Name="CountdownRecurCheck" Content="循环（完成后按相同时长重新开始）"
                                      Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                      Checked="OnCountdownRecurChanged" Unchecked="OnCountdownRecurChanged"
                                      ToolTip="勾选后，点「完成」时会以完成时刻为新起点、按相同时长自动新建一个倒计时" />

                            <!-- 倒计时「重新开始计时」：在完成/删除之上 -->
                            <ui:Button x:Name="StartCountdownButton" Content="重新开始计时"
                                       Appearance="Danger"
                                       HorizontalAlignment="Stretch" Height="30" Margin="0,14,0,0"
                                       Click="OnStartCountdownClick" Visibility="Collapsed"
                                       ToolTip="以当前时刻为起点重新开始倒计时，并保持设定的时长" />

                            <!-- 操作按钮：仅可见项等宽并排；无可见项时整栏折叠（见 LayoutTaskActionButtons） -->
                            <Grid x:Name="TaskActionBar" Margin="0,8,0,0" Visibility="Collapsed">
                                <ui:Button x:Name="DuplicateTaskButton" Content="重建为新任务"
                                           HorizontalAlignment="Stretch" Height="30" Margin="3,0"
                                           Click="OnDuplicateTask" Visibility="Collapsed"
                                           ToolTip="基于已完成任务创建新的进行中任务" />
                                <ui:Button x:Name="CompleteTaskButton" Content="完成任务"
                                           HorizontalAlignment="Stretch" Height="30" Margin="3,0"
                                           Click="OnCompleteTask" Visibility="Collapsed"
                                           ToolTip="将当前任务标记为已完成" />
                                <ui:Button x:Name="DeleteEditingTaskButton" Content="删除该任务"
                                           Style="{StaticResource HopeDangerButton}"
                                           HorizontalAlignment="Stretch" Height="30" Margin="3,0"
                                           Click="OnDeleteEditingTask" Visibility="Collapsed"
                                           ToolTip="永久删除当前正在编辑的任务" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 关于 -->
                <TabItem Header="关于" x:Name="AboutTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="4,8,8,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题 + 分割线 -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Hope · 盼头" FontWeight="Bold" FontSize="18"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,4,0,8" />
                                <Border Height="1" Margin="0,0,0,12"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </StackPanel>

                            <!-- 简介（顶）+ 彩蛋（底），同一块、无分割线 -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Hope（盼头）会在屏幕最上方显示一根分段彩色进度条，提示距离死线已经消耗了多少时间。&#x0a;简洁、非侵入式占屏，十分友好。及时提醒用户注意时间，提高效率，充满正能量。&#x0a;&#x0a;A lightweight tool that reminds you when you can go home.&#x0a;A little hope for leaving work on time." />

                                <StackPanel Grid.Row="2" Margin="0,16,0,4"
                                            MouseLeftButtonDown="OnEasterEggClick"
                                            Cursor="Hand">
                                    <TextBlock Text="八小时工作，八小时休息，八小时归自己！"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="——《八小时之歌》（1878）"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 分割线：更新和许可证 -->
                            <Grid Grid.Row="2" Margin="0,4,0,8">
                                <Border Height="1" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="更新和许可证" HorizontalAlignment="Center"
                                           Background="{DynamicResource ApplicationBackgroundBrush}"
                                           Padding="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 更新和许可证区域 -->
                            <StackPanel Grid.Row="3">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="AboutVersionText" Text="应用程序版本号 v0.0.0"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="BackendVersionText" Text="内核版本号 获取中…"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <DockPanel>
                                    <TextBlock x:Name="UpdateProgressDetail" DockPanel.Dock="Right"
                                               Margin="12,0,0,0" VerticalAlignment="Top"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed"
                                               Text="0%, 0 kBps" />
                                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                                               Text="点击「检查更新」获取最新版本。"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,8,0,0"
                                             Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBox x:Name="UpdateNotesBox" Margin="0,8,0,0"
                                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         Visibility="Collapsed" />
                                <WrapPanel Margin="0,10,0,0">
                                    <ui:Button x:Name="CheckUpdateButton" Content="检查更新"
                                               Margin="0,0,8,8" Click="OnCheckUpdate" />
                                    <ui:Button x:Name="DownloadUpdateButton" Content="下载并更新"
                                               Appearance="Primary" Margin="0,0,8,8"
                                               Visibility="Collapsed" Click="OnDownloadUpdate" />
                                    <ui:Button x:Name="StoreUpdateButton" Content="前往 Microsoft Store 更新"
                                               Appearance="Primary" Margin="0,0,8,8"
                                               Visibility="Collapsed" Click="OnOpenStoreUpdate" />
                                    <ui:Button x:Name="InstallUpdateButton" Content="立即安装"
                                               Appearance="Primary" Margin="0,0,8,8"
                                               Visibility="Collapsed" Click="OnInstallUpdate" />
                                    <ui:Button x:Name="SkipVersionButton" Content="跳过此版本"
                                               Margin="0,0,8,8" Visibility="Collapsed"
                                               Click="OnSkipVersion" />
                                    <ui:Button x:Name="LicensesButton" Content="许可证"
                                               Margin="0,0,8,8" Click="OnShowLicenses"
                                               ToolTip="查看本项目使用的第三方组件及其许可证信息" />
                                    <ui:Button x:Name="OpenLogFolderButton" Content="打开日志文件夹"
                                               Margin="0,0,8,8" Click="OnOpenLogFolder"
                                               ToolTip="打开 Hope 的 Debug 和 Release 日志目录" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Toast 宿主：底部水平居中；瞬时最多 3 条 + Sticky 业务校验（见 HopeToasts） -->
            <StackPanel x:Name="ToastHost"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Panel.ZIndex="100" />
        </Grid>
    </Grid>
</ui:FluentWindow>
